# Application Settings
APP_NAME="SafeTrip"
APP_ENV=local
APP_URL=http://localhost/safetrip
APP_DEBUG=true
SESSION_NAME=safetrip_session
SESSION_SECURE_COOKIE=false

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=safetrip
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Mail / SMTP Configuration (for OTP and Emergency Alerts)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@safetrip.com
MAIL_FROM_NAME="SafeTrip"
MAIL_MODE=smtp

# AI Assistant (Groq Cloud API Key)
GROQ_API_KEY=your_groq_api_key_here
